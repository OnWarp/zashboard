{
  "name": "zashboard",
  "account_id": "b4d48bf1df46d3ead23002dee838719e",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "DEFAULT_BACKEND_URL": "https://api.cudy.us.ci"
  },
  "observability": {
    "enabled": true
  }
}
